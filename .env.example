# Copy this to `.env` and fill in your values.

# OpenAI API key (Responses API access required, gpt-5 must be enabled on the key)
OPENAI_API_KEY=sk-...

# Which model the pipeline calls.
OPENAI_MODEL=gpt-5.2

# Hugging Face token (needed for gated model downloads, e.g. facebook/sam3)
HF_TOKEN=hf_...
