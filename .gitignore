# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Virtual environments ───────────────────────────────────────────────
.venv/
venv/
env/
.python-version

# ── Secrets ─────────────────────────────────────────────────────────────
.env
.env.local
*.pem
*.key
credentials*

# ── Pipeline outputs (generated per run, large) ────────────────────────
output/
runs/
logs/
*.log

# ── Model checkpoints (re-downloaded from Hugging Face cache) ──────────
ckpt/
*.ckpt
*.pt
*.pth
*.pth.tar
*.safetensors
*.bin
*.ts
*.gguf

# ── Diffusers / HF cache (per-user) ────────────────────────────────────
.cache/

# ── IDE / editor ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~
.DS_Store

# ── Large media incidental to runs ─────────────────────────────────────
*.mp4
*.mov
*.avi

# ── InstaFormer integration (cloned repo + isolated venv + local CUDA
# toolkit build, all environment-specific and multi-GB) ────────────────
InstaFormer/
.instaformer-venv/
cuda-11.8-local/
detectron2/

# ── LISA (legacy, unused at runtime — vendored upstream clone + its own
# venv, multi-GB; see SETUP.md). Our custom CLI wrapper is tracked below. ─
.lisa-venv/
LISA/*
!LISA/predict_single.py

# ── Hunyuan3D-2.1 (optional 3D-generation step — vendored upstream clone,
# multi-GB; see SETUP.md). Our custom CLI wrapper is tracked below. ──────
Hunyuan3D-2.1/*
!Hunyuan3D-2.1/generate_3d.py

# ── Backup / archive artifacts ─────────────────────────────────────────
output.zip
results_backup/
